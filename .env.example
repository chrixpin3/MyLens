# ---------------------------------------------------------------------------
# Copy to .env.local (git-ignored) and fill in. Every value here is required
# for the features that use it; the app boots without them and degrades
# gracefully, except MONGODB_URI which is mandatory in production.
# ---------------------------------------------------------------------------

# --- Database (MongoDB Atlas) ---------------------------------------------
# Cluster > Connect > Drivers > Node.js. Add the IP allow-list entry for
# "0.0.0.0/0" (or your deployment platform's egress IPs) in Atlas Network
# Access, otherwise serverless functions cannot connect.
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"
# Optional: override the database named in the connection string.
# MONGODB_DB="photographer-portfolio"

# --- Auth (NextAuth) ------------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"
# Use your real origin in production, e.g. https://your-domain.com
NEXTAUTH_URL="http://localhost:3000"

# --- Cloudinary (image hosting + signed direct uploads) --------------------
# Dashboard > Settings > API Keys. Only the API *secret* stays server-side;
# the key and cloud name are exposed to the browser on purpose, which is what
# makes signed, progress-reporting direct uploads possible.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Optional: folder that all uploads are written into.
# CLOUDINARY_FOLDER="photographer-portfolio"

# --- Email (contact-form notifications) ------------------------------------
# Optional. Without a key, inquiries are still stored and shown in the
# dashboard inbox — they are just not emailed.
# RESEND_API_KEY="re_xxxxxxxxx"
# RESEND_FROM="Portfolio <portfolio@yourdomain.com>"

# --- Seed credentials (used only by `npm run seed`) ------------------------
# Defaults: photographer / adminphotographer@123
# Set SEED_ADMIN_PASSWORD before seeding anything you intend to deploy, then
# change it again from Dashboard > Account after the first sign-in.
# SEED_ADMIN_USERNAME="photographer"
# SEED_ADMIN_PASSWORD="adminphotographer@123"
# SEED_ADMIN_EMAIL=""

# --- Site ------------------------------------------------------------------
# Absolute base URL used by sitemap.ts, robots.ts and OG tags.
# NEXT_PUBLIC_SITE_URL="https://your-domain.com"
